}

# --- n8n (container n8n-n8n-1, /opt/n8n) ---
# Veio do servidor de aplicacoes em 11/09/2026 (la vivia em swap; antes disso
# no VPS de infra, removido em 08/09). Motor comercial: todo produto da casa
# chama n8n.avilaops.com pelo nome publico, entao mudar de maquina nao muda
# nenhuma configuracao deles.
n8n.avilaops.com {
	# Celular (11/09/2026): o n8n prende o cabecalho das listas e rola so a
	# lista; num iPhone sobra menos da metade da tela para os fluxos. O HTML do
	# editor passa por um template do Caddy que injeta /avila-n8n-mobile.css
	# (em /opt/n8n/override). API, webhooks, assets e WebSocket vao direto.
	# Doc: app.avilaops.com/docs/n8n-celular-cabecalho.md
	@editor_html {
		method GET
		header Accept *text/html*
		not path *.* /rest/* /webhook* /form* /chat* /mcp* /api/* /oauth* /sso* /push* /healthz* /metrics* /assets/* /static/* /__n8n_index
	}
	handle /__n8n_index {
		rewrite * /
		reverse_proxy 127.0.0.1:5678
	}
	handle /avila-n8n-mobile.css {
		root * /opt/n8n/override
		header Cache-Control "public, max-age=300"
		file_server
	}
	handle /avila-n8n-credentials.css {
		root * /opt/n8n/override
		header Cache-Control "public, max-age=300"
		file_server
	}
	handle /avila-n8n-credentials.js {
		root * /opt/n8n/override
		header Cache-Control "public, max-age=300"
		file_server
	}
	handle /avila-credential-icons/* {
		root * /opt/n8n/override
		header Cache-Control "public, max-age=86400"
		file_server
	}
	handle /avila-modules.css {
		reverse_proxy 127.0.0.1:5679
	}
	handle /avila-modules.js {
		reverse_proxy 127.0.0.1:5679
	}
	handle /avila {
		redir * /avila/ 308
	}
	handle_path /avila/* {
		reverse_proxy 127.0.0.1:5679
	}
	handle_path /avila-api/* {
		reverse_proxy 127.0.0.1:5679
	}
	handle @editor_html {
		root * /opt/n8n/override
		rewrite * /index.html
		header Cache-Control "no-store"
		templates
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:5678 {
			# O editor usa WebSocket para execucao ao vivo; sem cabecalho longo a
			# tela fica "conectando" para sempre.
			flush_interval -1
		}
	}
}

# --- Notas (Outline, container notas-outline 3090, /opt/notas-avilaops-com) ---
# Login pelo auth.avilaops.com (OIDC), que continua no servidor de aplicacoes.
notas.avilaops.com {
	encode zstd gzip
	# Websocket obrigatorio: edicao colaborativa em tempo real.
	reverse_proxy 127.0.0.1:3090 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# --- Avila IA (containers ia-app 3092 e ia-worker, /opt/ia) ---
ia.avilaops.com {
	encode zstd gzip
	request_body {
		max_size 40MB
	}
	reverse_proxy 127.0.0.1:3092 {
		transport http {
			response_header_timeout 5m
			read_timeout 5m
			write_timeout 5m
		}
	}
}

