# --- Notas (Outline, container notas-outline 3090, /opt/notas-avilaops-com) ---
# Login pelo auth.avilaops.com (OIDC), que continua no servidor de aplicacoes.
notas.avilaops.com {
	encode zstd gzip
	# Websocket obrigatorio: edicao colaborativa em tempo real.
	reverse_proxy 127.0.0.1:3090 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# --- Avila IA (containers ia-app 3092 e ia-worker, /opt/ia) ---
ia.avilaops.com {
	encode zstd gzip
	request_body {
		max_size 40MB
	}
	reverse_proxy 127.0.0.1:3092 {
		transport http {
			response_header_timeout 5m
			read_timeout 5m
			write_timeout 5m
		}
	}
}

