# --- PartsAgricola (systemd agricola-storefront 3006, /opt/agricola-storefront) ---
# Veio do servidor de aplicacoes em 28/09/2026. Passa pelo proxy da Cloudflare com
# "Always Use HTTPS", entao o desafio HTTP-01 nao chega aqui: o certificado e da
# Origin CA da Cloudflare (valido ate 2041), em /etc/caddy/certs.
partsagricola.com.br {
	tls /etc/caddy/certs/partsagricola.crt /etc/caddy/certs/partsagricola.key
	encode zstd gzip
	reverse_proxy 127.0.0.1:3006
}

www.partsagricola.com.br {
	tls /etc/caddy/certs/partsagricola.crt /etc/caddy/certs/partsagricola.key
	redir https://partsagricola.com.br{uri} permanent
}

# Avila TV (Avila Link): painel da TV de casa. Migrado de applications em 01/10/2026.
# O agente roda no PC do Nicolas (10.10.0.3:8790) e chega pela WireGuard, roteada via applications (10.10.0.2).
tv.avilaops.com {
	encode zstd gzip
	# Descanso de tela da TV: estatico, servido daqui mesmo para nao depender do PC de casa.
	handle_path /descanso* {
		root * /var/www/avila-tv/descanso
		# A Cloudflare guardaria este HTML por horas; a TV precisa ver a edicao.
		header Cache-Control "no-cache, must-revalidate"
		file_server
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
	reverse_proxy 10.10.0.3:8790 {
		health_uri /
		health_interval 10s
		health_timeout 5s
		transport http {
			dial_timeout 5s
			response_header_timeout 40s
		}
	}
	handle_errors {
		respond "Agente da TV offline: o PC de casa precisa estar ligado e com o WireGuard ativo. ({err.status_code})" {err.status_code}
	}
}

