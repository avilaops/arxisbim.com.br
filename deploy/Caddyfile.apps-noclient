# --- Arxis (containers arxisvr-web 3102 e arxisvr-api 3101, /opt/arxisvr) ---
# Dominio proprio desde 17/09/2026; aplicado aqui em 10/10/2026, com o DNS de
# arxisbim.com.br, www e api apontando para esta maquina.
# Runbook: documentation/MIGRACAO-2026-09-17-dominio-arxisbim.md
arxisbim.com.br {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3102
}

# App do Arxis (login, validador, visualizador): a mesma SPA do container
# arxisvr-web. O site publico em arxisbim.com.br vai para o CMS.
app.arxisbim.com.br {
	encode zstd gzip
	# O noindex do bundle depende de JavaScript; este vale para qualquer robo.
	header X-Robots-Tag "noindex"
	reverse_proxy 127.0.0.1:3102
}

# www manda para o apex: um endereco so indexado, um so no analytics.
www.arxisbim.com.br {
	redir https://arxisbim.com.br{uri} 308
}

api.arxisbim.com.br {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3101
}

# Dominio anterior: o site redireciona (308 preserva metodo e passa o sinal de
# SEO para o canonico), preservando caminho e query de links ja publicados.
arxisvr.avilaops.com, www.arxisvr.avilaops.com {
	redir https://arxisbim.com.br{uri} 308
}

# A API antiga NAO redireciona. Redirecionar quebraria o preflight do CORS e os
# POST do plugin do Revit ja instalado, que nao seguem 3xx com corpo. Ela
# continua servindo o mesmo backend ate o fim da janela de transicao (prazo e
# criterio de desligamento no runbook).
api.arxisvr.avilaops.com {
	encode zstd gzip
	handle_path /engineering-bim/v1/* {
		reverse_proxy 127.0.0.1:3140
	}
	handle {
		reverse_proxy 127.0.0.1:3101
	}
}

# --- CRM (container agenda-crm-app 3020, /opt/agenda-crm/current) ---
crm.avilaops.com {
	reverse_proxy 127.0.0.1:3020
}

# --- Avila SMS (containers sms 3091 e sms-smpp 3093, /opt/sms) ---
sms.avilaops.com {
	encode zstd gzip

	# /api/interno/* aceita "envie no nome desta conta" com um token so, que
	# vale para todas as contas. Quem chama e o n8n, que desde 11/09/2026 roda
	# NESTE servidor: o pedido sai do container pelo IP publico da maquina
	# (204.168.249.111), nao pela bridge, entao ele entra na lista. O token
	# continua sendo a fechadura; isto e a corrente.
	@interno_de_fora {
		path /api/interno/*
		not remote_ip 127.0.0.1 ::1 172.16.0.0/12 204.168.249.111
	}
	respond @interno_de_fora 403

	# Metricas da rota SMPP: o Prometheus que as lia (VPS de infra) nao existe
	# mais; a rota fica fechada para tudo que nao for o proprio host.
	handle /metricas/smpp {
		@fora not remote_ip 127.0.0.1 ::1
		respond @fora 403
		rewrite * /metricas
		reverse_proxy 127.0.0.1:3093
	}

	reverse_proxy 127.0.0.1:3091
}

