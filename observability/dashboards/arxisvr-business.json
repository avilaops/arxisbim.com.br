        {
          "datasource": {
            "type": "postgres",
            "uid": "arxisvr-observability"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  t.name as tenant_name,\n  COUNT(DISTINCT u.id) as total_users,\n  COUNT(DISTINCT u.id) FILTER (WHERE u.is_active = true) as active_users,\n  COUNT(DISTINCT f.id) as ifc_files,\n  COALESCE(SUM(f.file_size), 0) as total_storage_bytes,\n  t.created_at::date as created_date\nFROM tenants t\nLEFT JOIN users u ON u.tenant_id = t.id\nLEFT JOIN ifc_files f ON f.tenant_id = t.id\nWHERE t.is_active = true\nGROUP BY t.id, t.name, t.created_at\nORDER BY total_users DESC\nLIMIT 20",
          "refId": "A"
        }
      ],
      "title": "Top Tenants by Users",
      "type": "table"
