        {
          "datasource": {
            "type": "postgres",
            "uid": "arxisvr-observability"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  t.name as tenant_name,\n  COUNT(f.id) as file_count,\n  ROUND(SUM(f.file_size) / 1024.0 / 1024.0, 2) as total_storage_mb,\n  ROUND(AVG(f.file_size) / 1024.0 / 1024.0, 2) as avg_file_mb\nFROM tenants t\nJOIN ifc_files f ON f.tenant_id = t.id\nWHERE t.is_active = true\nGROUP BY t.id, t.name\nORDER BY total_storage_mb DESC\nLIMIT 20",
          "refId": "A"
        }
      ],
      "title": "Top Tenants by Storage",
