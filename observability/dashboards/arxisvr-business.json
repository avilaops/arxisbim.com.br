      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "arxisvr-observability"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  u.email,\n  t.name as tenant,\n  COUNT(*) FILTER (WHERE a.action = 'auth.login') as login_count,\n  MAX(a.timestamp) as last_login,\n  u.two_factor_enabled,\n  u.is_email_verified,\n  u.created_at::date as registered_date\nFROM users u\nLEFT JOIN tenants t ON t.id = u.tenant_id\nLEFT JOIN audit_logs a ON a.user_id = u.id\nWHERE u.is_active = true\n  AND a.timestamp > NOW() - INTERVAL '7 days'\nGROUP BY u.id, u.email, t.name, u.two_factor_enabled, u.is_email_verified, u.created_at\nORDER BY login_count DESC\nLIMIT 30",
          "refId": "A"
        }
      ],
      "title": "Most Active Users (7 days)",
      "type": "table"
    }
