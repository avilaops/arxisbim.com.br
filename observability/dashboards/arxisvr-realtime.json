          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  metadata->>'endpoint' as endpoint,\n  labels->>'method' as method,\n  COUNT(*) as requests,\n  ROUND(AVG(duration)::numeric, 2) as avg_ms,\n  ROUND(MAX(duration)::numeric, 2) as max_ms\nFROM performance_metrics \nWHERE operation = 'api.request' \n  AND timestamp > NOW() - INTERVAL '1 minute'\n  AND metadata->>'endpoint' IS NOT NULL\nGROUP BY metadata->>'endpoint', labels->>'method'\nORDER BY requests DESC\nLIMIT 10",
