          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT \n  time_bucket('5 minutes', timestamp) AS time,\n  action,\n  COUNT(*) as count\nFROM audit_logs \nWHERE action IN ('user.login', 'user.created', 'user.logout')\n  AND $__timeFilter(timestamp)\nGROUP BY time, action\nORDER BY time",
