        {
          "datasource": {
            "type": "postgres",
            "uid": "arxisvr-observability"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  schemaname,\n  tablename,\n  ROUND(pg_total_relation_size(schemaname||'.'||tablename) / 1024.0 / 1024.0, 2) as total_size_mb,\n  n_tup_ins as inserts,\n  n_tup_upd as updates,\n  n_tup_del as deletes,\n  seq_scan,\n  idx_scan\nFROM pg_stat_user_tables\nORDER BY pg_total_relation_size(schemaname||'.'||tablename) DESC\nLIMIT 15",
          "refId": "A"
        }
      ],
      "title": "Table Statistics",
      "type": "table"
