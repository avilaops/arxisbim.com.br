          "rawQuery": true,
          "rawSql": "SELECT \n  pid,\n  usename as user,\n  application_name,\n  state,\n  ROUND(EXTRACT(EPOCH FROM (NOW() - query_start)) * 1000) as duration_ms,\n  LEFT(query, 100) as query\nFROM pg_stat_activity\nWHERE state != 'idle' \n  AND query NOT LIKE '%pg_stat_activity%'\nORDER BY query_start\nLIMIT 10",
