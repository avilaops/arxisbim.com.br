          "datasource": {
            "type": "postgres",
            "uid": "arxisvr-observability"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  metadata->>'endpoint' as endpoint,\n  labels->>'method' as method,\n  COUNT(*) as requests,\n  ROUND(AVG(duration)::numeric, 2) as avg_ms,\n  ROUND(MAX(duration)::numeric, 2) as max_ms,\n  ROUND(percentile_cont(0.95) WITHIN GROUP (ORDER BY duration)::numeric, 2) as p95_ms\nFROM performance_metrics \nWHERE operation = 'api.request' \n  AND timestamp > NOW() - INTERVAL '15 minutes'\n  AND metadata->>'endpoint' IS NOT NULL\nGROUP BY metadata->>'endpoint', labels->>'method'\nORDER BY avg_ms DESC\nLIMIT 20",
          "refId": "A"
        }
      ],
      "title": "Slowest Endpoints (15min)",
      "type": "table"
