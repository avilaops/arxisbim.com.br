          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT \n  time_bucket('30 seconds', timestamp) AS time,\n  AVG(duration) as p50,\n  percentile_cont(0.95) WITHIN GROUP (ORDER BY duration) as p95,\n  percentile_cont(0.99) WITHIN GROUP (ORDER BY duration) as p99,\n  MAX(duration) as max\nFROM performance_metrics \nWHERE operation = 'api.request' \n  AND $__timeFilter(timestamp)\nGROUP BY time\nORDER BY time",
          "refId": "A"
        }
      ],
      "title": "API Latency Percentiles (P50, P95, P99, Max)",
      "type": "timeseries"
