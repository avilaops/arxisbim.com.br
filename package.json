{
  "name": "arxisvr-monorepo",
  "version": "1.0.0",
  "description": "ArxisVR - Plataforma BIM colaborativa com AR/VR",
  "private": true,
  "scripts": {
    "setup:links": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\link-local-deps.ps1",
    "predev": "npm run setup:links",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:signaling\" --names \"BACKEND,FRONTEND,SIGNALING\" --prefix-colors \"blue,green,yellow\"",
    "dev:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\dev-backend-local.ps1",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:signaling": "cd signaling-server && npm run dev",
    "build": "cd backend && npm install && npm run build && cd .. && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && pnpm install && pnpm run build",
    "prestart": "if [ \"$NODE_ENV\" != \"production\" ]; then npm run setup:links; fi",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\" \"npm run start:signaling\" --names \"BACKEND,FRONTEND,SIGNALING\" --prefix-colors \"blue,green,yellow\"",
    "start:backend": "cd backend && npm install && npm start",
    "start:frontend": "cd frontend && npm run preview",
    "start:signaling": "cd signaling-server && npm start",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install && cd ../signaling-server && npm install"
  },
  "keywords": [
    "bim",
    "ar",
    "vr",
    "collaboration",
    "ifc",
    "arxisvr"
  ],
  "author": "ArxisVR Team",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.713.0",
    "@aws-sdk/s3-request-presigner": "^3.713.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fontsource/inter": "^5.2.8",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.218.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.218.0",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@sentry/node": "^10.53.1",
    "@tensorflow/tfjs": "^4.22.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/socket.io-client": "^3.0.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.28.0",
    "fastify": "^5.8.5",
    "jsonwebtoken": "^9.0.3",
    "livekit-server-sdk": "^2.15.3",
    "minio": "^8.0.7",
    "postgres": "^3.4.9",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "three": "^0.184.0",
    "web-ifc": "^0.0.77",
    "web-ifc-three": "^0.0.126",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^8.2.2",
    "drizzle-kit": "^0.31.10",
    "ts-jest": "^29.4.11",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
