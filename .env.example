# =====================================
# .env.example — Template de referência
# Copie para .env.local, .env.staging ou .env.production e configure
# =====================================

# ========== DATABASE ==========
DATABASE_URL=postgres://user:password@localhost:5432/arxisvr_dev
DB_USER=arxisvr
DB_PASSWORD=your_secure_password
DB_NAME=arxisvr_dev

# ========== BACKEND ==========
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# JWT & Security
JWT_SECRET=your_jwt_secret_key_min_32_chars_change_this_value
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# CORS - comma-separated origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ========== FRONTEND ==========
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3002
VITE_WS_SERVER=ws://localhost:3002
VITE_SIGNALING_SERVER=ws://localhost:3002

# ========== OBSERVABILITY ==========
GRAFANA_PASSWORD=admin
PROMETHEUS_RETENTION=15d

# ========== SIGNALING SERVER ==========
SIGNALING_PORT=3002
SIGNALING_HOST=0.0.0.0

# ========== EMAIL SERVICE ==========
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your_email_password
EMAIL_FROM=noreply@arxisvr.example.com
SMTP_FROM=noreply@arxisvr.example.com

# ========== STORAGE ==========
# Storage driver: "local" (filesystem, default) or "s3" (MinIO / AWS S3)
STORAGE_DRIVER=local

# --- Used when STORAGE_DRIVER=local ---
UPLOAD_DIR=./backend/uploads
MAX_FILE_SIZE=104857600

# --- Used when STORAGE_DRIVER=s3 ---
# Endpoint the backend uses to talk to the object store (MinIO or AWS S3).
# For AvilaOps production MinIO: https://minio.avilaops.com
S3_ENDPOINT=https://minio.avilaops.com
# Optional: separate public endpoint used only for presigned URLs.
# Set this if the backend reaches MinIO on an internal network but the
# browser must use a different public host.
# S3_PUBLIC_ENDPOINT=https://minio.avilaops.com
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=arxisvr
# MinIO requires path-style addressing. Leave true unless you know better.
S3_FORCE_PATH_STYLE=true
# Default expiry (seconds) for presigned GET/PUT URLs.
S3_PRESIGN_EXPIRES=900

# ========== REDIS (optional, for distributed caching) ==========
REDIS_URL=redis://localhost:6379

# ========== THIRD-PARTY INTEGRATIONS ==========
# SINAPI/CYPE (Sprint 8)
CYPE_API_KEY=
CYPE_API_URL=

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ========== MONITORING & ANALYTICS ==========
SENTRY_DSN=
DATADOG_API_KEY=

# ========== DEPLOYMENT ==========
ENVIRONMENT=development
APP_VERSION=1.1.0
BUILD_NUMBER=
DEPLOYMENT_ID=
