# Exemplo de configuração de ambiente para desenvolvimento e testes
# Renomeie para .env e ajuste os valores conforme seu ambiente

DATABASE_URL=postgres://usuario:senha@localhost:5432/arxisvr_dev
JWT_SECRET=sua_chave_secreta_min_32_chars
JWT_REFRESH_SECRET=outra_chave_diferente_min_32_chars
BCRYPT_ROUNDS=12
PORT=3001

# Billing provider
BILLING_PROVIDER=stripe

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Billing webhook retry worker
BILLING_RETRY_WORKER_ENABLED=true
BILLING_RETRY_INTERVAL_MS=60000
BILLING_RETRY_BATCH_SIZE=20

# Stripe Price IDs (definidos no dashboard Stripe)
STRIPE_PRICE_FREE_MONTHLY=price_replace_me
STRIPE_PRICE_FREE_YEARLY=price_replace_me
STRIPE_PRICE_STARTER_MONTHLY=price_replace_me
STRIPE_PRICE_STARTER_YEARLY=price_replace_me
STRIPE_PRICE_PRO_MONTHLY=price_replace_me
STRIPE_PRICE_PRO_YEARLY=price_replace_me
STRIPE_PRICE_BUSINESS_MONTHLY=price_replace_me
STRIPE_PRICE_BUSINESS_YEARLY=price_replace_me

# URLs app/backend
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
