{
    "name": "arxisvr-backend",
    "version": "1.0.1",
    "description": "ArxisVR Backend API - Fastify + TypeScript",
    "main": "dist/index.js",
    "exports": {
        ".": {
            "import": "./src/index.ts",
            "require": "./src/index.ts"
        }
    },
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "node build.mjs",
        "build:tsc": "tsc",
        "start": "node dist/index.js",
        "type-check": "tsc --noEmit",
        "audit:routes": "node scripts/audit/run.mjs",
        "audit:routes:ci": "node scripts/audit/run.mjs --strict",
        "test": "vitest run"
    },
    "keywords": [
        "fastify",
        "typescript",
        "api",
        "bim",
        "arxisvr"
    ],
    "author": "ArxisVR Team",
    "license": "MIT",
    "engines": {
        "node": "20.x",
        "npm": ">=10"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.713.0",
        "@aws-sdk/lib-storage": "^3.1064.0",
        "@aws-sdk/s3-request-presigner": "^3.713.0",
        "@fastify/cors": "^11.2.0",
        "@fastify/helmet": "^13.0.2",
        "@fastify/multipart": "^10.0.0",
        "@fastify/oauth2": "^8.2.0",
        "@fastify/rate-limit": "^10.3.0",
        "@fastify/static": "^8.0.0",
        "@gltf-transform/core": "^4.0.0",
        "@gltf-transform/extensions": "^4.0.0",
        "@gltf-transform/functions": "^4.0.0",
        "@opentelemetry/auto-instrumentations-node": "^0.76.0",
        "@opentelemetry/exporter-metrics-otlp-proto": "^0.218.0",
        "@opentelemetry/exporter-trace-otlp-proto": "^0.218.0",
        "@opentelemetry/sdk-metrics": "^2.7.1",
        "@opentelemetry/sdk-node": "^0.218.0",
        "@sentry/node": "^10.53.1",
        "@types/nodemailer": "^8.0.0",
        "bcrypt": "^6.0.0",
        "bcryptjs": "^3.0.3",
        "decimal.js": "^10.6.0",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "esbuild": "^0.28.0",
        "fastify": "^5.8.5",
        "fastify-raw-body": "^5.0.0",
        "jsonwebtoken": "^9.0.3",
        "livekit-server-sdk": "^2.15.3",
        "minio": "^8.0.7",
        "nodemailer": "^8.0.10",
        "otplib": "^13.4.1",
        "postgres": "^3.4.9",
        "qrcode": "^1.5.4",
        "resend": "^6.12.4",
        "socket.io": "^4.8.3",
        "stripe": "^22.2.0",
        "three": "^0.149.0",
        "uuid": "^11.0.5",
        "web-ifc": "^0.0.77",
        "web-ifc-three": "^0.0.126",
        "xlsx": "^0.18.5",
        "zod": "^4.4.3",
        "@react-pdf/renderer": "^4.0.0",
        "react": "^19.2.6"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/bcryptjs": "^3.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/qrcode": "^1.5.6",
        "@typescript-eslint/eslint-plugin": "^7.8.0",
        "@typescript-eslint/parser": "^7.8.0",
        "eslint": "^8.56.0",
        "tsx": "^4.22.3",
        "typescript": "^6.0.3",
        "vitest": "^4.1.7",
        "@types/react": "^19.0.0"
    }
}
