{
    "name": "arxisvr-backend",
    "version": "1.0.1",
    "description": "ArxisVR Backend API - Fastify + TypeScript",
    "main": "dist/index.js",
    "exports": {
        ".": {
            "import": "./src/index.ts",
            "require": "./src/index.ts"
        }
    },
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "type-check": "tsc --noEmit"
    },
    "keywords": [
        "fastify",
        "typescript",
        "api",
        "bim",
        "arxisvr"
    ],
    "author": "ArxisVR Team",
    "license": "MIT",
    "engines": {
        "node": ">=18.0.0"
    },
    "dependencies": {
        "@fastify/static": "^8.0.0",
        "bcryptjs": "^3.0.3",
        "dotenv": "^17.4.2",
        "jsonwebtoken": "^9.0.3",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/bcryptjs": "^3.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "tsx": "^4.22.3",
        "typescript": "^6.0.3",
        "vitest": "^4.1.7"
    }
}
