{
    "name": "arxisvr-backend",
    "version": "1.0.1",
    "description": "ArxisVR Backend API - Fastify + TypeScript",
    "main": "dist/index.js",
    "exports": {
        ".": {
            "import": "./src/index.ts",
            "require": "./src/index.ts"
        }
    },
    "type": "module",
    "scripts": {
        "dev": "tsx watch --import ./src/env.ts --import ./src/instrument.ts src/index.ts",
        "build": "node build.mjs",
        "build:tsc": "tsc",
        "start": "node --import ./dist/instrument.js dist/index.js",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "verify:migrations": "node scripts/verify-migrations.mjs",
        "conferir": "npm run type-check && npm run build"
    },
    "keywords": [
        "fastify",
        "typescript",
        "api",
        "bim",
        "arxisvr"
    ],
    "author": "ArxisVR Team",
    "license": "MIT",
    "engines": {
        "node": ">=24",
        "npm": ">=10"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1143.0",
        "@aws-sdk/lib-storage": "^3.1143.0",
        "@aws-sdk/s3-request-presigner": "^3.1143.0",
        "@fastify/cors": "^11.3.0",
        "@fastify/helmet": "^13.1.1",
        "@fastify/multipart": "^10.1.2",
        "@fastify/oauth2": "^8.3.0",
        "@fastify/rate-limit": "^11.2.0",
        "@fastify/static": "^10.1.5",
        "@gltf-transform/core": "^4.5.1",
        "@gltf-transform/extensions": "^4.5.1",
        "@gltf-transform/functions": "^4.5.1",
        "@opentelemetry/auto-instrumentations-node": "^0.77.0",
        "@opentelemetry/exporter-metrics-otlp-proto": "^0.219.0",
        "@opentelemetry/exporter-trace-otlp-proto": "^0.219.0",
        "@opentelemetry/sdk-metrics": "^2.7.1",
        "@opentelemetry/sdk-node": "^0.219.0",
        "@react-pdf/renderer": "^4.0.0",
        "@sentry/node": "^11.7.0",
        "bcrypt": "^6.0.0",
        "bcryptjs": "^3.0.3",
        "decimal.js": "^10.6.0",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.3",
        "esbuild": "^0.28.0",
        "fastify": "^5.12.5",
        "jsonwebtoken": "^9.0.3",
        "livekit-server-sdk": "^2.19.1",
        "minio": "^8.0.7",
        "nodemailer": "^10.0.13",
        "postgres": "^3.4.9",
        "react": "^19.2.6",
        "resend": "^6.12.4",
        "socket.io": "^4.8.3",
        "three": "^0.149.0",
        "uuid": "^11.0.5",
        "web-ifc": "^0.0.77",
        "web-ifc-three": "^0.0.126",
        "xlsx": "^0.18.5",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/bcryptjs": "^3.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/react": "^19.0.0",
        "@typescript-eslint/eslint-plugin": "^7.8.0",
        "@typescript-eslint/parser": "^7.8.0",
        "drizzle-kit": "^0.31.11",
        "eslint": "^8.56.0",
        "tsx": "^4.22.3",
        "typescript": "^6.0.3",
        "vitest": "^4.1.7"
    }
}
