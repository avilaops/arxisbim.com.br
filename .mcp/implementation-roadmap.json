          "activity": "Quarterly security audits",
          "owner": "Security Team",
          "frequency": "quarterly"
        },
        {
          "activity": "Performance optimization",
          "owner": "Engineering",
          "frequency": "ongoing"
        },
        {
          "activity": "New RAG domain additions",
          "owner": "ML Team",
          "frequency": "as-needed"
        },
        {
          "activity": "New MCP server integrations",
          "owner": "Engineering",
