        "deliverables": [
          {
            "item": "E2E test suite",
            "coverage": "> 80%",
            "status": "required"
          },
          {
            "item": "Security audit report",
            "standard": "ISO 27001",
            "penTest": true,
            "status": "required"
          },
          {
            "item": "Load testing results",
            "target": "10,000 req/min",
            "p95Latency": "< 500ms",
