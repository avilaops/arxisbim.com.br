{
  "mcpServers": [
    {
      "id": "mcp-erp",
      "name": "ERP Integration Server",
      "description": "Read-only access to SAP/Oracle ERP data",
      "type": "database",
      "status": "active",
      "dataClassification": "confidential",
      "connection": {
        "type": "odbc",
        "host": "${ERP_HOST}",
        "port": "${ERP_PORT}",
        "database": "${ERP_DB}",
        "user": "${ERP_USER}",
        "password": "${ERP_PASSWORD}",
        "readonly": true
      },
      "tools": [
        {
          "name": "query_customers",
          "description": "Query customer data (anonymized)",
          "params": ["customer_id", "name_filter"],
          "anonymize": ["cpf", "email", "phone"]
        },
        {
          "name": "query_orders",
          "description": "Query order history",
          "params": ["order_id", "date_from", "date_to"]
        },
        {
          "name": "query_inventory",
          "description": "Query inventory levels",
          "params": ["product_id", "warehouse"]
        }
      ],
      "permissions": ["admin", "analyst"],
      "rateLimit": {
        "maxRequests": 100,
        "window": "1h"
      },
      "cache": {
        "enabled": true,
        "ttl": 300
      }
    },
    {
      "id": "mcp-docs",
      "name": "Technical Documentation Server",
      "description": "Access to external technical documentation catalog",
      "type": "http",
      "status": "active",
      "dataClassification": "public",
      "command": "node",
      "args": ["dist/index.js"],
      "cwd": "./",
      "tools": [
        {
          "name": "search_docs",
          "description": "Search documentation sources"
        },
        {
          "name": "fetch_doc_page",
          "description": "Fetch documentation page content"
        },
        {
          "name": "list_categories",
          "description": "List documentation categories"
        }
      ],
      "resources": [
        {
          "uri": "docs://catalog",
          "name": "Documentation Catalog"
        }
      ],
      "permissions": ["*"],
      "rateLimit": {
        "maxRequests": 1000,
        "window": "1h"
      }
    },
    {
      "id": "mcp-audit",
      "name": "Audit & Logging Server",
      "description": "Centralized audit logs with LGPD compliance",
      "type": "database",
      "status": "active",
      "dataClassification": "confidential",
      "connection": {
        "type": "postgres",
        "host": "${AUDIT_DB_HOST}",
        "port": 5432,
        "database": "audit_logs",
        "user": "${AUDIT_DB_USER}",
        "password": "${AUDIT_DB_PASSWORD}"
      },
      "tools": [
        {
          "name": "log_event",
          "description": "Log an audit event",
          "params": ["event_type", "user_id", "resource", "action", "metadata"]
        },
        {
          "name": "query_logs",
          "description": "Query audit logs with filters",
          "params": ["date_from", "date_to", "user_id", "event_type"],
          "permissions": ["admin"]
        },
        {
          "name": "generate_compliance_report",
          "description": "Generate LGPD compliance report",
          "params": ["month", "year"],
          "permissions": ["admin"]
        }
      ],
      "permissions": ["admin"],
      "retention": {
        "enabled": true,
        "days": 730
      }
    },
    {
      "id": "mcp-github",
      "name": "GitHub Integration Server",
      "description": "Access to code repositories and documentation",
      "type": "api",
      "status": "active",
      "dataClassification": "internal",
      "connection": {
        "type": "rest",
        "baseUrl": "https://api.github.com",
        "auth": {
          "type": "token",
          "token": "${GITHUB_TOKEN}"
        }
      },
      "tools": [
        {
          "name": "search_code",
          "description": "Search code across repositories",
          "params": ["query", "repo", "language"]
        },
        {
          "name": "get_file",
          "description": "Get file content from repository",
          "params": ["repo", "path", "ref"]
        },
        {
          "name": "list_repos",
          "description": "List organization repositories",
          "params": ["org", "visibility"]
        }
      ],
      "permissions": ["admin", "developer"],
      "rateLimit": {
        "maxRequests": 5000,
        "window": "1h"
      }
    }
  ]
}
