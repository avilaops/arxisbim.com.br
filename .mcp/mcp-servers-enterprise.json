{
  "mcpServers": [
    {
      "id": "mcp-sap-erp",
      "name": "SAP ERP Integration",
      "description": "Read-only access to SAP S/4HANA",
      "type": "odata",
      "status": "active",
      "region": "GLOBAL",
      "dataClassification": "confidential",
      "connection": {
        "type": "odata-v4",
        "baseUrl": "${SAP_BASE_URL}",
        "authentication": {
          "type": "oauth2",
          "clientId": "${SAP_CLIENT_ID}",
          "clientSecret": "${SAP_CLIENT_SECRET}",
          "tokenEndpoint": "${SAP_TOKEN_URL}"
        },
        "readonly": true,
        "timeout": 30000
      },
      "tools": [
        {
          "name": "query_business_partners",
          "description": "Query business partners (customers/vendors)",
          "entitySet": "A_BusinessPartner",
          "fields": ["BusinessPartner", "BusinessPartnerName", "Country"],
          "anonymize": ["TaxNumber", "EmailAddress", "PhoneNumber"],
          "permissions": ["admin", "analyst", "sales"]
        },
        {
          "name": "query_sales_orders",
          "description": "Query sales orders",
          "entitySet": "A_SalesOrder",
          "fields": ["SalesOrder", "SoldToParty", "SalesOrderDate", "TotalNetAmount"],
          "permissions": ["admin", "analyst", "sales"]
        },
        {
          "name": "query_materials",
          "description": "Query material master data",
          "entitySet": "A_Product",
          "fields": ["Product", "ProductDescription", "ProductType"],
          "permissions": ["admin", "analyst", "operations"]
        }
      ],
      "permissions": ["admin", "analyst", "sales", "operations"],
      "rateLimit": {
        "maxRequests": 100,
        "window": "1m"
      },
      "cache": {
        "enabled": true,
        "ttl": 300
      },
      "audit": {
        "logAllQueries": true,
        "sensitiveData": true
      }
    },
    {
      "id": "mcp-oracle-ebs",
      "name": "Oracle E-Business Suite Integration",
      "description": "Oracle EBS database access (read-only)",
      "type": "database",
      "status": "active",
      "region": "GLOBAL",
      "dataClassification": "confidential",
      "connection": {
        "type": "oracle",
        "host": "${ORACLE_HOST}",
        "port": 1521,
        "serviceName": "${ORACLE_SERVICE}",
        "user": "${ORACLE_USER}",
        "password": "${ORACLE_PASSWORD}",
        "readonly": true,
        "connectionPooling": {
          "min": 2,
          "max": 10
        }
      },
      "tools": [
        {
          "name": "query_customers",
          "description": "Query customer accounts",
          "schema": "AR",
          "table": "HZ_PARTIES",
          "anonymize": ["EMAIL_ADDRESS", "PHONE_NUMBER"],
          "permissions": ["admin", "analyst"]
        },
        {
          "name": "query_invoices",
          "description": "Query invoice data",
          "schema": "AR",
          "table": "RA_CUSTOMER_TRX_ALL",
          "permissions": ["admin", "finance"]
        },
        {
          "name": "query_inventory",
          "description": "Query inventory levels",
          "schema": "INV",
          "table": "MTL_ONHAND_QUANTITIES",
          "permissions": ["admin", "operations"]
        }
      ],
      "permissions": ["admin", "analyst", "finance", "operations"],
      "rateLimit": {
        "maxRequests": 50,
        "window": "1m"
      },
      "audit": {
        "logAllQueries": true,
        "sensitiveData": true
      }
    },
    {
      "id": "mcp-salesforce",
      "name": "Salesforce CRM Integration",
      "description": "Salesforce API access for CRM data",
      "type": "rest",
      "status": "active",
      "region": "US",
      "dataClassification": "personal",
      "connection": {
        "type": "rest",
        "baseUrl": "${SALESFORCE_INSTANCE_URL}/services/data/v59.0",
        "authentication": {
          "type": "oauth2",
          "clientId": "${SALESFORCE_CLIENT_ID}",
          "clientSecret": "${SALESFORCE_CLIENT_SECRET}",
          "username": "${SALESFORCE_USERNAME}",
          "password": "${SALESFORCE_PASSWORD}",
          "securityToken": "${SALESFORCE_SECURITY_TOKEN}"
        }
      },
      "tools": [
        {
          "name": "query_accounts",
          "description": "Query Salesforce accounts",
          "soql": "SELECT Id, Name, Industry, AnnualRevenue FROM Account",
          "anonymize": ["BillingAddress", "Phone"],
          "permissions": ["admin", "sales", "analyst"]
        },
        {
          "name": "query_opportunities",
          "description": "Query sales opportunities",
          "soql": "SELECT Id, Name, StageName, Amount, CloseDate FROM Opportunity",
          "permissions": ["admin", "sales"]
        },
        {
          "name": "query_cases",
          "description": "Query customer support cases",
          "soql": "SELECT Id, CaseNumber, Subject, Status, Priority FROM Case",
          "anonymize": ["SuppliedEmail", "SuppliedPhone"],
          "permissions": ["admin", "support"]
        }
      ],
      "permissions": ["admin", "sales", "support", "analyst"],
      "rateLimit": {
        "maxRequests": 100,
        "window": "1m"
      },
      "audit": {
        "logAllQueries": true,
        "sensitiveData": true
      }
    },
    {
      "id": "mcp-aws-services",
      "name": "AWS Services Integration",
      "description": "AWS cloud services access",
      "type": "sdk",
      "status": "active",
      "region": "MULTI",
      "dataClassification": "internal",
      "connection": {
        "type": "aws-sdk",
        "accessKeyId": "${AWS_ACCESS_KEY_ID}",
        "secretAccessKey": "${AWS_SECRET_ACCESS_KEY}",
        "region": "us-east-1"
      },
      "tools": [
        {
          "name": "list_s3_buckets",
          "description": "List S3 buckets with metadata",
          "service": "s3",
          "action": "listBuckets",
          "permissions": ["admin", "devops"]
        },
        {
          "name": "query_cloudwatch_metrics",
          "description": "Query CloudWatch metrics",
          "service": "cloudwatch",
          "action": "getMetricData",
          "permissions": ["admin", "devops", "analyst"]
        },
        {
          "name": "list_ec2_instances",
          "description": "List EC2 instances",
          "service": "ec2",
          "action": "describeInstances",
          "permissions": ["admin", "devops"]
        },
        {
          "name": "query_rds_databases",
          "description": "List RDS database instances",
          "service": "rds",
          "action": "describeDBInstances",
          "permissions": ["admin", "devops", "dba"]
        }
      ],
      "permissions": ["admin", "devops", "analyst", "dba"],
      "rateLimit": {
        "maxRequests": 200,
        "window": "1m"
      }
    },
    {
      "id": "mcp-azure-services",
      "name": "Azure Services Integration",
      "description": "Microsoft Azure cloud services",
      "type": "sdk",
      "status": "active",
      "region": "MULTI",
      "dataClassification": "internal",
      "connection": {
        "type": "azure-sdk",
        "tenantId": "${AZURE_TENANT_ID}",
        "clientId": "${AZURE_CLIENT_ID}",
        "clientSecret": "${AZURE_CLIENT_SECRET}",
        "subscriptionId": "${AZURE_SUBSCRIPTION_ID}"
      },
      "tools": [
        {
          "name": "list_storage_accounts",
          "description": "List Azure Storage accounts",
          "service": "storage",
          "permissions": ["admin", "devops"]
        },
        {
          "name": "query_app_insights",
          "description": "Query Application Insights telemetry",
          "service": "application-insights",
          "permissions": ["admin", "devops", "analyst"]
        },
        {
          "name": "list_vms",
          "description": "List virtual machines",
          "service": "compute",
          "permissions": ["admin", "devops"]
        }
      ],
      "permissions": ["admin", "devops", "analyst"],
      "rateLimit": {
        "maxRequests": 200,
        "window": "1m"
      }
    },
    {
      "id": "mcp-gcp-services",
      "name": "Google Cloud Platform Integration",
      "description": "GCP services access",
      "type": "sdk",
      "status": "active",
      "region": "MULTI",
      "dataClassification": "internal",
      "connection": {
        "type": "gcp-sdk",
        "projectId": "${GCP_PROJECT_ID}",
        "credentials": "${GCP_SERVICE_ACCOUNT_KEY}"
      },
      "tools": [
        {
          "name": "list_gcs_buckets",
          "description": "List Google Cloud Storage buckets",
          "service": "storage",
          "permissions": ["admin", "devops"]
        },
        {
          "name": "query_bigquery",
          "description": "Query BigQuery datasets",
          "service": "bigquery",
          "permissions": ["admin", "analyst", "data_engineer"]
        },
        {
          "name": "list_compute_instances",
          "description": "List Compute Engine instances",
          "service": "compute",
          "permissions": ["admin", "devops"]
        }
      ],
      "permissions": ["admin", "devops", "analyst", "data_engineer"],
      "rateLimit": {
        "maxRequests": 200,
        "window": "1m"
      }
    },
    {
      "id": "mcp-compliance-audit",
      "name": "Multi-Jurisdiction Compliance & Audit Server",
      "description": "Centralized compliance and audit logging",
      "type": "database",
      "status": "active",
      "region": "MULTI",
      "dataClassification": "confidential",
      "dataResidency": {
        "BR": "southamerica-east1",
        "EU": "europe-west1",
        "US": "us-central1",
        "CN": "asia-east2"
      },
      "connection": {
        "type": "postgres",
        "regions": {
          "BR": {
            "host": "${AUDIT_DB_BR_HOST}",
            "database": "audit_br"
          },
          "EU": {
            "host": "${AUDIT_DB_EU_HOST}",
            "database": "audit_eu"
          },
          "US": {
            "host": "${AUDIT_DB_US_HOST}",
            "database": "audit_us"
          },
          "CN": {
            "host": "${AUDIT_DB_CN_HOST}",
            "database": "audit_cn"
          }
        },
        "port": 5432,
        "user": "${AUDIT_DB_USER}",
        "password": "${AUDIT_DB_PASSWORD}",
        "ssl": true
      },
      "tools": [
        {
          "name": "log_data_access",
          "description": "Log data access event",
          "params": ["user_id", "resource", "action", "region", "classification"],
          "permissions": ["*"]
        },
        {
          "name": "log_consent",
          "description": "Log consent record",
          "params": ["user_id", "purpose", "granted", "region"],
          "permissions": ["*"]
        },
        {
          "name": "log_subject_rights_request",
          "description": "Log DSAR (Data Subject Access Request)",
          "params": ["request_id", "type", "user_id", "region", "regulation"],
          "permissions": ["admin", "dpo", "privacy_officer"]
        },
        {
          "name": "query_audit_logs",
          "description": "Query audit logs by filters",
          "params": ["date_from", "date_to", "region", "event_type", "user_id"],
          "permissions": ["admin", "dpo", "legal", "privacy_officer"]
        },
        {
          "name": "generate_compliance_report",
          "description": "Generate compliance report (LGPD/GDPR/CCPA/PIPL)",
          "params": ["regulation", "period", "region"],
          "permissions": ["admin", "dpo", "legal", "privacy_officer"]
        },
        {
          "name": "trigger_breach_notification",
          "description": "Initiate breach notification workflow",
          "params": ["incident_id", "severity", "affected_regions", "affected_count"],
          "permissions": ["admin", "dpo", "security"]
        }
      ],
      "permissions": ["admin", "dpo", "legal", "privacy_officer", "security"],
      "retention": {
        "enabled": true,
        "byRegion": {
          "BR": 2555,
          "EU": 2555,
          "US": 2555,
          "CN": 3650
        }
      },
      "immutable": true
    },
    {
      "id": "mcp-github-enterprise",
      "name": "GitHub Enterprise Integration",
      "description": "Access to enterprise code repositories",
      "type": "rest",
      "status": "active",
      "region": "GLOBAL",
      "dataClassification": "restricted",
      "connection": {
        "type": "rest",
        "baseUrl": "${GITHUB_ENTERPRISE_URL}/api/v3",
        "authentication": {
          "type": "token",
          "token": "${GITHUB_ENTERPRISE_TOKEN}"
        }
      },
      "tools": [
        {
          "name": "search_code",
          "description": "Search code across repositories",
          "endpoint": "/search/code",
          "permissions": ["admin", "developer"]
        },
        {
          "name": "get_repo_content",
          "description": "Get file content from repository",
          "endpoint": "/repos/{owner}/{repo}/contents/{path}",
          "permissions": ["admin", "developer"]
        },
        {
          "name": "list_pull_requests",
          "description": "List pull requests",
          "endpoint": "/repos/{owner}/{repo}/pulls",
          "permissions": ["admin", "developer", "reviewer"]
        },
        {
          "name": "get_commit_history",
          "description": "Get commit history",
          "endpoint": "/repos/{owner}/{repo}/commits",
          "permissions": ["admin", "developer", "auditor"]
        }
      ],
      "permissions": ["admin", "developer", "reviewer", "auditor"],
      "dlp": {
        "enabled": true,
        "preventSecrets": true,
        "scanPatterns": ["api_key", "password", "token", "certificate"]
      },
      "rateLimit": {
        "maxRequests": 5000,
        "window": "1h"
      }
    },
    {
      "id": "mcp-confluence-enterprise",
      "name": "Confluence Enterprise Integration",
      "description": "Access to internal documentation and knowledge base",
      "type": "rest",
      "status": "active",
      "region": "GLOBAL",
      "dataClassification": "internal",
      "connection": {
        "type": "rest",
        "baseUrl": "${CONFLUENCE_BASE_URL}/rest/api",
        "authentication": {
          "type": "basic",
          "username": "${CONFLUENCE_USER}",
          "password": "${CONFLUENCE_API_TOKEN}"
        }
      },
      "tools": [
        {
          "name": "search_content",
          "description": "Search Confluence pages and blogs",
          "endpoint": "/content/search",
          "permissions": ["*"]
        },
        {
          "name": "get_page",
          "description": "Get page content",
          "endpoint": "/content/{id}",
          "permissions": ["*"]
        },
        {
          "name": "list_spaces",
          "description": "List available spaces",
          "endpoint": "/space",
          "permissions": ["*"]
        }
      ],
      "permissions": ["*"],
      "rateLimit": {
        "maxRequests": 100,
        "window": "1m"
      }
    },
    {
      "id": "mcp-docs-catalog",
      "name": "BigTech Documentation Catalog",
      "description": "Catalog of external technical documentation",
      "type": "custom",
      "status": "active",
      "region": "GLOBAL",
      "dataClassification": "public",
      "command": "node",
      "args": ["dist/index.js"],
      "cwd": "./",
      "tools": [
        {
          "name": "search_docs",
          "description": "Search documentation sources by keyword"
        },
        {
          "name": "fetch_doc_page",
          "description": "Fetch documentation page content"
        },
        {
          "name": "list_categories",
          "description": "List all documentation categories"
        }
      ],
      "resources": [
        {
          "uri": "docs://catalog",
          "name": "Complete Documentation Catalog"
        }
      ],
      "permissions": ["*"],
      "rateLimit": {
        "maxRequests": 1000,
        "window": "1h"
      }
    }
  ],
  "orchestration": {
    "loadBalancing": {
      "enabled": true,
      "strategy": "least-latency",
      "healthCheck": "30s"
    },
    "failover": {
      "enabled": true,
      "retryAttempts": 3,
      "backoffStrategy": "exponential"
    },
    "circuitBreaker": {
      "enabled": true,
      "threshold": 5,
      "timeout": "60s"
    }
  }
}
