{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": false,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "skipLibCheck": true,
    "experimentalDecorators": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "paths": {
      "@/*": ["./src/*"],
      "three/addons/*": ["./node_modules/@types/three/examples/jsm/*"]
    },

  },
  /* O type-check cobre exatamente o que entra no bundle: o grafo de imports
     a partir de src/main.tsx (58 arquivos). Os ~800 arquivos orfaos em src/
     (fora do build desde a reescrita do frontend) somam 1.890 erros e sao
     divida de classificacao, nao portao de qualidade. */
  "files": [
    "src/main.tsx",
    "src/features/equipment-generator/index.ts",
    "src/features/equipment-generator/viewer/EquipmentViewerView.tsx",
    "src/features/equipment-generator/demo/main.ts",
    "src/env.d.ts",
    "src/global.d.ts",
    "src/node-shims.d.ts",
    "src/vite-env.d.ts"
  ],
  "include": [],
  "exclude": ["node_modules"]
}
