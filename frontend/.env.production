# Valores de build do frontend. Todos VITE_* viram texto no bundle publico,
# entao nao ha segredo aqui e o arquivo e versionado de proposito: sem ele o
# build cai no fallback embutido em apiBaseUrl.ts.
VITE_API_URL=https://api.arxisvr.avilaops.com
VITE_WS_URL=wss://api.arxisvr.avilaops.com
VITE_WS_SERVER=wss://api.arxisvr.avilaops.com
VITE_SIGNALING_SERVER=wss://api.arxisvr.avilaops.com
