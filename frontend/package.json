{
  "name": "arxisvr-frontend",
  "version": "1.0.1",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "equipment:export": "vite-node --config vitest.config.ts scripts/equipment-export.ts --",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css,md}\""
  },
  "dependencies": {
    "@babylonjs/core": "^9.12.0",
    "@babylonjs/loaders": "^9.12.0",
    "@fontsource/inter": "^5.2.8",
    "@marsidev/react-turnstile": "^1.5.2",
    "@sentry/react": "^10.61.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@tensorflow/tfjs": "^4.22.0",
    "autoprefixer": "^10.5.2",
    "esbuild": "^0.28.0",
    "i18next": "^26.3.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.0",
    "lit": "^3.3.3",
    "lucide-react": "^1.39.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "react-router-dom": "7.0.0",
    "rolldown": "1.0.2",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.3.1",
    "three": "0.149.0",
    "three-mesh-bvh": "^0.5.24",
    "web-ifc": "^0.0.77",
    "web-ifc-three": "^0.0.126",
    "yjs": "^13.6.33",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^5.3.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@types/three": "^0.149.0",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/ui": "^2.0.0",
    "@webgpu/types": "^0.1.70",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^24.0.0",
    "path": "^0.12.7",
    "prettier": "^3.2.5",
    "typescript": "^5.4.0",
    "vite": "8.0.14",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "alias": {
    "@": "./src"
  }
}
